[global_config]
  suppress_multiple_term_dialog = False
  title_transmit_bg_color = "#3465a4"
[keybindings]
[profiles]
  [[default]]
    scrollback_lines = 5000
    exit_action = hold
    use_system_font = False
    font = Monospace 10
[layouts]
  [[robot]]
    [[[window]]]
      type = Window
      parent = ""
      size = 1400, 900
    [[[columns]]]
      type = HPaned
      parent = window
      position = 700
    [[[left]]]
      type = VPaned
      parent = columns
      order = 0
      position = 560
    [[[right]]]
      type = VPaned
      parent = columns
      order = 1
      position = 400
    [[[launch]]]
      type = Terminal
      parent = left
      order = 0
      profile = default
      title = Simulation and safety
      command = /usr/local/bin/robot-terminal-command launch
    [[[drive]]]
      type = Terminal
      parent = left
      order = 1
      profile = default
      title = Keyboard driving
      command = /usr/local/bin/robot-terminal-command drive
    [[[obstacles]]]
      type = Terminal
      parent = right
      order = 0
      profile = default
      title = Closest obstacle
      command = /usr/local/bin/robot-terminal-command obstacles
    [[[services]]]
      type = VPaned
      parent = right
      order = 1
      position = 280
    [[[average]]]
      type = Terminal
      parent = services
      order = 0
      profile = default
      title = Average velocity (every 2 seconds)
      command = /usr/local/bin/robot-terminal-command average
    [[[threshold]]]
      type = Terminal
      parent = services
      order = 1
      profile = default
      title = Set safety threshold
      command = /usr/local/bin/robot-terminal-command threshold
[plugins]
